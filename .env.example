# Tùy chọn: cấu hình mặc định phq-education đã có trong src/lib/firebase-config.ts.
# Sao chép thành .env.local để ghi đè cấu hình khi phát triển.
# Đây là cấu hình Web, không phải khóa Service Account.
VITE_FIREBASE_CONFIG=
# Tự động bật khi mở quan-tri-mien-phi.bat.
VITE_LOCAL_ADMIN=false
# Chỉ dùng khi chạy Firebase Emulator trên máy:
VITE_USE_FIREBASE_EMULATORS=false
